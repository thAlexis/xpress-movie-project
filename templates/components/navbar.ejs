<% if (typeof role !== "undefined" && role === "admin") { %>
<nav
  class="flex w-[100%] bg-[#1B263B] justify-between items-center pl-[2rem] pr-[2rem]"
>
  <div>
    <a href="/"><img class="w-[6rem]" src="../img/logo2.png" /></a>
  </div>
  <div>
    <ul class="flex gap-[1rem] text-[#F5F5F5]">
      <li class="mr-[1rem]">
        Bonjour administrateur <%= firstname %> <%= lastname %>,
      </li>
      <li><a class="cursor-pointer" href="/home">Accueil</a></li>
      <li>
        <a class="cursor-pointer" href="/moviemanage">Gérer les films</a>
      </li>
      <li>
        <a
          class="cursor-pointer bg-[#A51F26] hover:bg-[#A00000] p-[0.8rem] rounded-[0.5rem]"
          href="/index/logout"
          >Se déconnecter</a
        >
      </li>
    </ul>
  </div>
</nav>
<% } else if (typeof role !== "undefined" && role === "user") {%>
<nav
  class="flex w-[100%] bg-[#1B263B] justify-between items-center pl-[2rem] pr-[2rem]"
>
  <div>
    <a href="/"><img class="w-[6rem]" src="../img/logo2.png" /></a>
  </div>
  <div>
    <ul class="flex gap-[1rem] text-[#F5F5F5]">
      <li>Bonjour <%= firstname %> <%= lastname %></li>
      <li><a class="cursor-pointer">Accueil</a></li>
      <li><a class="cursor-pointer" href="">Mes favoris</a></li>
      <li><a href="">Mon compte</a></li>
      <li><a class="cursor-pointer" href="/index/logout">Se déconnecter</a></li>
    </ul>
  </div>
</nav>
<% } else if (typeof role == "undefined") { %>

<nav
  class="flex w-[100%] bg-[#1B263B] justify-between items-center pl-[2rem] pr-[2rem]"
>
  <div>
    <a href="/"><img class="w-[6rem]" src="../img/logo2.png" /></a>
  </div>
  <div>
    <ul class="flex gap-[1rem] text-[#F5F5F5]">
      <li><a class="cursor-pointer">Accueil</a></li>
      <li><a class="cursor-pointer" href="/signin">Connexion</a></li>
      <li><a class="cursor-pointer" href="/signup">Inscription</a></li>
    </ul>
  </div>
</nav>
<% } %>
