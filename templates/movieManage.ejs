<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%- include("../config/dependencies.ejs") %>
    <title>Gérer les films</title>
  </head>
  <body>
    <%- include("components/navbar.ejs") %>
    <div class="flex justify-center">
      <div
        class="bg-[#1B263B] text-white mt-[2rem] flex flex-col w-[25%] p-[2rem] rounded-[1rem]"
      >
        <h1 class="text-[1.8rem] self-center mb-[1rem]">Ajouter un film</h1>
        <form class="flex flex-col" method="post">
          <label for="title">Titre du film</label>
          <input
            class="bg-white mb-[1rem] text-black rounded-[0.5rem] p-[0.2rem]"
            type="text"
            name="title"
          />
          <label for="image">Nom image</label>
          <input
            class="bg-white mb-[1rem] text-black rounded-[0.5rem] p-[0.2rem]"
            type="text"
            name="image"
          />
          <label for="summary">Résumé</label>
          <input
            class="bg-white mb-[1rem] text-black rounded-[0.5rem] p-[0.2rem]"
            type="text"
            name="summary"
          />
          <label for="releaseDate">Date de sortie</label>
          <input
            class="bg-white mb-[1rem] text-black rounded-[0.5rem] p-[0.2rem]"
            type="date"
            name="releaseDate"
          />
          <label for="genre">Genre</label>
          <input
            class="bg-white text-black mb-[1rem] rounded-[0.5rem] p-[0.2rem]"
            type="text"
            name="genre"
          />
          <button
            class="bg-white text-black w-[min-content] self-center p-[1rem] rounded-[1rem] cursor-pointer"
          >
            Ajouter
          </button>
        </form>
      </div>
      <div></div>
    </div>
  </body>
</html>
