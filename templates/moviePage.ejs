<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%- include("../config/dependencies.ejs") %>
    <title>Fiche film</title>
  </head>
  <body class="bg-[#F5F5F5]">
    <%- include("components/navbar.ejs") %>
    <div class="flex flex-col items-center mt-[1rem]">
      <h1 class="text-[3rem] font-bold"><%= movie.title %></h1>
      <div class="flex mt-[2rem] gap-[5rem] w-[80%] justify-center">
        <div>
          <img class="h-[35rem]" src="../img/<%= movie.image %>.jpg" />
        </div>
        <div class="w-[50%] mt-[1rem]">
          <h2 class="text-[1.5rem] font-bold">Résumé</h2>
          <p class="mt-[0.4rem]"><%= movie.summary %></p>
          <h2 class="text-[1.5rem] font-bold mt-[1rem]">Date de sortie</h2>
          <p class="mt-[0.4rem]">
            <%= new Date(movie.release_date).toLocaleDateString('fr-FR') %>
          </p>
          <h2 class="text-[1.5rem] font-bold mt-[1rem]">Genre</h2>
          <p class="mt-[0.4rem]"><%= movie.genre %></p>
          <% if (typeof role !== "undefined" && role == "user") { %>
          <div class="flex gap-[2rem]">
            <% if (!movieFavs.includes(movie.id.toString())) { %>
            <form method="post">
              <button
                class="bg-[#1B263B] block hover:bg-[#1A299F] text-white p-[1rem] mt-[2rem] rounded-[0.4rem] cursor-pointer w-[max-content]"
              >
                Ajouter à mes favoris
              </button>
            </form>
            <% } else { %>

            <form action="<%= movie.id %>?_method=DELETE" method="post">
              <button
                class="bg-red-900 block hover:bg-red-700 text-white p-[1rem] mt-[2rem] rounded-[0.4rem] cursor-pointer w-[max-content]"
              >
                Supprimer de mes favoris
              </button>
            </form>
            <% } %>
          </div>

          <% } %>
        </div>
      </div>
    </div>
  </body>
</html>
