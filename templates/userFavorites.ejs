<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%- include("../config/dependencies.ejs") %>
    <title>Favoris</title>
  </head>
  <body>
    <%- include("components/navbar.ejs") %>
    <div class="mr-[2rem] ml-[2rem] mt-[2rem] flex flex-col items-center">
      <h2 class="text-[2rem] font-bold">Mes favoris</h2>
      <div class="grid grid-cols-5 mt-[1.5rem] gap-[2rem]">
        <% for (const movie of movies) { %>
        <a
          class="w-[15rem] flex transition-transform hover:scale-[110%]"
          href="./moviePage/<%= movie.id %>"
          ><div
            class="flex flex-col items-center shadow-md p-[1rem] rounded-[0.6rem] bg-white"
          >
            <img class="h-[18rem]" src="../img/<%= movie.image %>.jpg" />
            <h3 class="mt-[1rem] font-bold text-center"><%= movie.title %></h3>
          </div></a
        >
        <% } %>
      </div>
    </div>
  </body>
</html>
